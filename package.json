{
  "name": "swipecut",
  "version": "1.0.0",
  "description": "SwipeCut - Video splitting and Tinder-style UI for video editing",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "check": "npm run lint --prefix frontend && npm run build",
    "test": "node --test frontend/tests/*.test.mjs && npm run check",
    "deploy": "npm test && wrangler deploy",
    "start": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "wrangler": "^4.133.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
