{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swipecut",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "SwipeCutContainer",
      "image": "./Dockerfile",
      "max_instances": 5,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SWIPECUT_CONTAINER",
        "class_name": "SwipeCutContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SwipeCutContainer"]
    }
  ],
  "routes": [
    {
      "pattern": "swipecut.kotalabo.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
