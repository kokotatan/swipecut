{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swipecut",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "swipecut.kotalabo.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
